rules_version = '2';

// GasFlow Storage rules. QR images live under /barcodes.
service firebase.storage {
  match /b/{bucket}/o {
    match /barcodes/{file=**} {
      allow read: if true;                 // QR images are shareable
      allow write: if request.auth != null; // only signed-in users upload
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
