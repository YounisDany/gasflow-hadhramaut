rules_version = '2';

// DEMO / SCHOOL-PROJECT RULES — intentionally open.
// The app seeds and reads the bundled demo dataset at startup without requiring
// a signed-in user, so reads/writes are allowed for everyone. This is fine for a
// prototype but MUST be locked down (auth + role checks) before any production
// release. See git history for the previous auth-gated version.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
